# Copy to .env and adjust. The docker-compose file works without a .env (it falls back to
# development defaults below), but a real deployment MUST set these.
#
# Viper reads these with the MYAPP_ prefix (dots become underscores), so
# config.yaml -> database.url  ==  MYAPP_DATABASE_URL
MYAPP_DATABASE_URL=mongodb://root:devpassword@localhost:27017
MYAPP_DATABASE_NAME=zinx
MYAPP_REDIS_URL=redis://localhost:6379/1
MYAPP_JWT_SECRET=dev-secret-change-me

# docker-compose only
MONGO_PASSWORD=devpassword
# host ports (change these when another local stack already owns 27017/6379/8999)
MONGO_PORT=27017
REDIS_PORT=6379
SERVER_PORT=8999

# Optional third-party login client ids
MYAPP_GOOGLE_CLIENT_ID=
MYAPP_APPLE_CLIENT_ID=
MYAPP_APPLE_GOOGLE_CLIENT_ID=
